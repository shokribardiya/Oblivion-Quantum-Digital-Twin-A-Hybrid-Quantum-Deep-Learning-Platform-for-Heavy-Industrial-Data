class SeoulTOPIProvider(IDataConnector):
    def __init__(self, api_key: str):
        self.api_key = api_key
        self.base_url = f"http://openapi.seoul.go.kr:8088/{api_key}/json/TopisUrbanTrafficStatus/1/1000/"
    def get_city_id(self) -> str:
        return "seoul"
    async def fetch(self) -> Dict[str, Any]:
        if not aiohttp:
            return self._dummy()
        try:
            async with aiohttp.ClientSession() as sess:
                async with sess.get(self.base_url, timeout=15) as resp:
                    if resp.status == 200:
                        return self._parse(await resp.json())
        except Exception as exc:
            logger.error(f"Seoul fetch failed: {exc}")
        return self._dummy()
    def _parse(self, raw):
        rows = raw.get("TopisUrbanTrafficStatus", {}).get("row", [])
        return {"roads": [{"id": r["ROAD_NM"], "speed": float(r["SPEED"]), "lat": float(r["LAT"]), "lng": float(r["LNG"]), "ts": datetime.now(timezone.utc).isoformat()} for r in rows]}
    def _dummy(self):
        # realistic fallback for 50 roads
        roads = []
        for i in range(50):
            roads.append({"id": f"road_{i}", "speed": np.random.randint(10,80) if np else 40, "lat": 37.5+np.random.randn()*0.05, "lng": 126.9+np.random.randn()*0.05, "ts": datetime.now(timezone.utc).isoformat()})
        return {"roads": roads}

