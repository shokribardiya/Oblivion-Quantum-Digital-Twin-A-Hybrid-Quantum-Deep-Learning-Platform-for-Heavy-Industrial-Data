# 9. Main Entry Point
# =============================================================================
def main():
    config = SystemConfig()
    nexus = OblivionNexusCore(config)
    try:
        asyncio.run(nexus.start())
    except KeyboardInterrupt:
        asyncio.run(nexus.shutdown())

if __name__ == "__main__":
