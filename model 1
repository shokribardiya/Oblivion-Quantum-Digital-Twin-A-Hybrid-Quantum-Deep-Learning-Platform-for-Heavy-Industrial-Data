# =============================================================================
# 8. The Core Engine (Microkernel)
# =============================================================================
class OblivionNexusCore:
    """
    Central Microkernel that orchestrates all subsystems.
    Can be extended with plugins without modifying this file.
    """
    def __init__(self, config: SystemConfig):
        self.cfg = config
        self.lake = DataLake(config.data_lake)
        self.connector: IDataConnector = self._init_connector()
        self.ai_pipeline: IMLPipeline = STGraphTransformer(config.ai)
        self.quantum: IQuantumOptimizer = QAOAOptimizer(config.quantum)
        self.security = MITREATLASSimulator(config.security)
        self._event_loop = asyncio.get_event_loop()
        self._stop_event = asyncio.Event()
        # Model registry (abstract)
        self.model_version = 0

    def _init_connector(self) -> IDataConnector:
        if self.cfg.city == CityID.SEOUL:
            return SeoulTOPIProvider(api_key=os.getenv("SEOUL_KEY", ""))
        else:
            raise ValueError(f"Connector for {self.cfg.city} not implemented")

    async def ingestion_loop(self):
        while not self._stop_event.is_set():
            data = await self.connector.fetch()
            roads = data.get("roads", [])
            await self.lake.write_batch(roads)
            # trigger prediction every 5 minutes
            await asyncio.sleep(self.cfg.update_interval)

    async def training_pipeline(self):
        # scheduled retraining
        while not self._stop_event.is_set():
            df = self.lake.read_as_dataframe(time_window_h=24)
            if df is not None and not df.empty:
                self.ai_pipeline.train(df, None)
            await asyncio.sleep(3600)  # retrain hourly

    async def start(self):
        logger.info("🚀 Oblivion Nexus starting...")
        loop = asyncio.get_running_loop()
        tasks = [
            loop.create_task(self.ingestion_loop()),
            loop.create_task(self.training_pipeline()),
        ]
        # FastAPI app
        app = self._create_api()
        if uvicorn:
            config = uvicorn.Config(app, host="0.0.0.0", port=self.cfg.api_port, log_level="info")
            server = uvicorn.Server(config)
            tasks.append(loop.create_task(server.serve()))
        await asyncio.gather(*tasks, return_exceptions=True)

    def _create_api(self):
        if not fastapi:
            return None
        from fastapi import FastAPI, WebSocket
        from fastapi.responses import HTMLResponse
        app = FastAPI(title="Oblivion Nexus API", version="1.0")

        @app.get("/")
        def root():
            return {"message": "Oblivion CityOS is running"}

        @app.websocket("/stream")
        async def websocket_endpoint(ws: WebSocket):
            await ws.accept()
            while True:
                data = await self.connector.fetch()
                await ws.send_json(data)
                await asyncio.sleep(2)
        return app

    async def shutdown(self):
        self._stop_event.set()
        logger.info("Shutting down Oblivion Nexus.")

