# 8. CORE ENGINE – OBLIVION NEXUS (Microkernel)
# =============================================================================
class OblivionNexus:
    """Central orchestrator that ties all subsystems together."""
    def __init__(self, config: SystemConfig):
        self.cfg = config
        self.source: IDataSource = self._init_source()
        self.lake: IDataLake = DeltaLakeDataLake(config.data_lake_path)
        self.ai: IAIModel = STGNNTransformerModel(config)
        self.quantum: IQuantumOptimizer = QAOAOptimizer(config)
        self.cyber = CyberRange() if config.security_enabled else None

        # Thread‑safe bridge for Streamlit
        self._data_queue = queue.Queue(maxsize=1)
        self._stop_event = threading.Event()
        self._bg_thread = threading.Thread(target=self._run_async_loop, daemon=True)
        self._bg_thread.start()

        # Last fetched data cache
        self.latest_data: Dict = {"roads": [], "source": "initializing"}
        self.prediction_cache: Optional[Dict] = None

    def _init_source(self) -> IDataSource:
        if self.cfg.city == CityID.SEOUL:
            return SeoulTOPISDataSource(self.cfg.api_key)
        else:
            raise NotImplementedError(f"Connector for {self.cfg.city} not implemented")

    def _run_async_loop(self):
        """Background thread running asyncio event loop."""
        loop = asyncio.new_event_loop()
        asyncio.set_event_loop(loop)
        try:
            loop.run_until_complete(self._ingestion_loop())
        finally:
            loop.close()

    async def _ingestion_loop(self):
        while not self._stop_event.is_set():
            data = await self.source.fetch()
            self.latest_data = data
            # Write to data lake
            roads = data.get("roads", [])
            if roads:
                self.lake.write(roads)
            # Put in queue for Streamlit
            try:
                self._data_queue.put_nowait(data)
            except queue.Full:
                pass
            # Periodic AI retraining (in background)
            await asyncio.sleep(self.cfg.update_interval_sec)

    def get_latest_data(self) -> Dict:
        """Non‑blocking access from Streamlit."""
        try:
            return self._data_queue.get_nowait()
        except queue.Empty:
            return self.latest_data

    def trigger_prediction(self) -> Any:
        roads = self.latest_data.get("roads", [])
        if roads:
            preds = self.ai.predict(roads)
            self.prediction_cache = {"predicted_speeds": preds, "roads": roads}
            return self.prediction_cache
        return None

    def train_model(self):
        """Manually trigger training."""
        self.ai.train(None)

    def run_quantum_optimizer(self) -> Dict:
        return self.quantum.run()

    def launch_cyber_attack(self, attack_type: str, **kwargs) -> Any:
        if self.cyber:
            return self.cyber.execute_attack(attack_type, self.latest_data.get("roads", []), **kwargs)
        return {"error": "Cyber range disabled"}

    def shutdown(self):
        self._stop_event.set()

