# 4. DATA LAKE ON DELTA LAKE (MINIO / LOCAL FS)
# =============================================================================
class DeltaLakeDataLake(IDataLake):
    def __init__(self, base_path: str):
        self.base_path = base_path
        self._table = None
        if deltalake:
            try:
                import deltalake
                self._init_delta()
            except Exception:
                self._table = None

    def _init_delta(self):
        # Use local storage instead of MinIO for simplicity
        storage_opts = {"allow_unsafe_rename": "true"}
        try:
            self._table = deltalake.DeltaTable(self.base_path, storage_options=storage_opts)
        except Exception:
            # Create new table
            schema = {"id": str, "speed_kmh": float, "lat": float, "lng": float,
                      "congestion": str, "ts": str}
            self._table = deltalake.DeltaTable.create(self.base_path, schema=schema,
                                                      storage_options=storage_opts)

    def write(self, records: List[Dict]):
        if not records:
            return
        if self._table and pd:
            df = pd.DataFrame(records)
            try:
                self._table.merge(
                    source=df,
                    predicate="target.id = source.id",
                    source_alias="source",
                    target_alias="target"
                ).when_matched_update_all().when_not_matched_insert_all().execute()
                logger.info(f"Delta Lake: wrote {len(records)} records")
            except Exception as e:
                logger.error(f"Delta write error: {e}")
        else:
            # Fallback to CSV
            csv_path = Path(self.base_path) / "traffic.csv"
            csv_path.parent.mkdir(exist_ok=True)
            if pd:
                df = pd.DataFrame(records)
                df.to_csv(csv_path, mode='a', header=not csv_path.exists(), index=False)

    def read(self, time_window_h: float = 1) -> Any:
        if self._table and pd:
            try:
                return self._table.to_pandas()
            except Exception:
                pass
        csv_path = Path(self.base_path) / "traffic.csv"
        if csv_path.exists() and pd:
            return pd.read_csv(csv_path)
        return pd.DataFrame() if pd else None

