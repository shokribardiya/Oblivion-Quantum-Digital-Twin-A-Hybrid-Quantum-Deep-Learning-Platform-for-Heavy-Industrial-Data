# 3. REAL DATA CONNECTOR FOR SEOUL (TOPIS)
# =============================================================================
class SeoulTOPISDataSource(IDataSource):
    def __init__(self, api_key: str):
        self.api_key = api_key
        self.base_url = f"http://openapi.seoul.go.kr:8088/{api_key}/json/TopisUrbanTrafficStatus/1/1000/"

    async def fetch(self) -> Dict:
        if not aiohttp:
            return self._generate_synthetic_data()
        try:
            async with aiohttp.ClientSession() as session:
                async with session.get(self.base_url, timeout=10) as resp:
                    if resp.status == 200:
                        raw = await resp.json()
                        return self._parse(raw)
        except Exception as e:
            logger.warning(f"TOPIS API failed: {e}. Using synthetic data.")
        return self._generate_synthetic_data()

    def _parse(self, raw: Dict) -> Dict:
        rows = raw.get("TopisUrbanTrafficStatus", {}).get("row", [])
        roads = []
        for r in rows:
            roads.append({
                "id": r.get("ROAD_NM", "unknown"),
                "speed_kmh": float(r.get("SPEED", 0)),
                "lat": float(r.get("LAT", 37.5665)),
                "lng": float(r.get("LNG", 126.9780)),
                "congestion": r.get("CONGESTION", "UNKNOWN"),
                "ts": datetime.now(timezone.utc).isoformat()
            })
        return {"roads": roads, "source": "live"}

    def _generate_synthetic_data(self) -> Dict:
        """Create realistic synthetic traffic for 50 roads in Seoul."""
        if not np:
            np_ = __import__("numpy")
        else:
            np_ = np
        roads = []
        road_names = [f"Road_{i}" for i in range(50)]
        for name in road_names:
            lat = 37.5 + np_.random.randn() * 0.05
            lng = 126.9 + np_.random.randn() * 0.08
            speed = np_.random.randint(10, 80)
            congestion = "SMOOTH" if speed > 40 else ("SLOW" if speed > 20 else "JAM")
            roads.append({
                "id": name,
                "speed_kmh": speed,
                "lat": lat,
                "lng": lng,
                "congestion": congestion,
                "ts": datetime.now(timezone.utc).isoformat()
            })
        return {"roads": roads, "source": "synthetic"}

