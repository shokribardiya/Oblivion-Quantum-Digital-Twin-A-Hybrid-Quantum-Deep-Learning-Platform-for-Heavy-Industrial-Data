def live_traffic_tab(st, nexus: OblivionNexus):
    st.header("🚦 Real‑Time Traffic Map")
    data = nexus.get_latest_data()
    roads = data.get("roads", [])
    if not roads:
        st.warning("Waiting for data stream...")
        return
    # Create folium map
    if folium:
        m = folium.Map(location=[37.5665, 126.9780], zoom_start=11, tiles="CartoDB dark_matter")
        for r in roads:
            speed = r["speed_kmh"]
            color = "#d62728" if speed < 20 else ("#ff7f0e" if speed < 40 else "#2ca02c")
            folium.CircleMarker(
                location=[r["lat"], r["lng"]],
                radius=6,
                popup=f"{r['id']}: {speed} km/h ({r['congestion']})",
                color=color, fill=True, fillColor=color, fillOpacity=0.7
            ).add_to(m)
        # Heatmap overlay
        from folium.plugins import HeatMap
        heat_data = [[r["lat"], r["lng"], 1 - r["speed_kmh"]/100] for r in roads]
        HeatMap(heat_data, radius=15).add_to(m)
        st_folium = __import__("streamlit_folium", fromlist=["st_folium"]).st_folium
        st_folium(m, width=1000, height=600)
    else:
        st.error("folium not installed.")
    # Metrics
    col1, col2, col3 = st.columns(3)
    avg_speed = sum(r["speed_kmh"] for r in roads) / len(roads)
    col1.metric("Avg Speed", f"{avg_speed:.1f} km/h")
    col2.metric("Roads Tracked", len(roads))
    col3.metric("Data Source", data.get("source", "unknown"))

