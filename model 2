def update_dashboard(n, reset_clicks):
    global data_queue, prediction_queue, twin_engine, streamer
    ctx = dash.callback_context
    if ctx.triggered and 'reset-btn' in ctx.triggered[0]['prop_id']:
        streamer.reset()
        data_queue.clear()
        prediction_queue.clear()
        twin_engine = None
        pretrain_model()
        return dash.no_update, dash.no_update, dash.no_update, dash.no_update, "System Reset Done"
    
    if twin_engine is None:
        return dash.no_update, dash.no_update, dash.no_update, dash.no_update, "Initializing..."
    
    # دریافت داده جدید و به‌روزرسانی همزاد
    new_sample = streamer.generate_sample()
    data_queue.append(new_sample)
    twin_engine.update_state(new_sample)
    if len(twin_engine.history_buffer) >= twin_engine.seq_len:
        pred = twin_engine.predict_next()  # (horizon, n_sensors)
        prediction_queue.append(pred)
    # همچنین یک گام یادگیری برخط با آخرین نمونه (اختیاری)
    if len(data_queue) >= twin_engine.seq_len + 1:
        # ساخت یک نمونه یادگیری ساده
        X_seq = np.array(list(data_queue))[-(twin_engine.seq_len+1):-1]
        y_next = np.array(list(data_queue))[-1]  # هدف گام بعدی
        twin_engine.continuous_learning_step((X_seq, y_next))
    
    # شکل ۱: نمودار زنده سنسورها
    df = pd.DataFrame(list(data_queue), columns=sensor_names)
    fig_sensors = go.Figure()
    for col in sensor_names[:5]:  # نمایش ۵ سنسور برای وضوح
        fig_sensors.add_trace(go.Scatter(y=df[col], mode='lines', name=col))
    fig_sensors.update_layout(title="Live Sensor Stream", template="plotly_dark", height=400)
    
    # شکل ۲: نمای سه‌بعدی همزاد (نقاط نمایانگر وضعیت کنونی)
    if len(data_queue) > 0:
        current_state = data_queue[-1]
        # کاهش ابعاد برای نمایش سه‌بعدی با سه مؤلفه اول
        x, y, z = current_state[0], current_state[1], current_state[2]
        fig_3d = go.Figure(data=[go.Scatter3d(x=[x], y=[y], z=[z], mode='markers',
                                             marker=dict(size=12, color='cyan', symbol='diamond'))])
        fig_3d.update_layout(title="Digital Twin 3D State", scene=dict(xaxis_title='Dim1', yaxis_title='Dim2', zaxis_title='Dim3'),
                             template="plotly_dark", height=400)
    else:
        fig_3d = go.Figure()
    
    # شکل ۳: پیش‌بینی افق آینده
    fig_pred = go.Figure()
    if prediction_queue:
        last_pred = prediction_queue[-1]  # (horizon, n_sensors)
        for i in range(min(3, last_pred.shape[1])):
            fig_pred.add_trace(go.Scatter(y=last_pred[:, i], mode='lines+markers', name=f'Pred Sensor_{i}'))
    fig_pred.update_layout(title="Prediction Horizon", template="plotly_dark", height=400)
    
    # شکل ۴: نمای ناهنجاری (ساده: تغییرات اخیر)
    if len(data_queue) > 20:
        recent = np.array(list(data_queue))[-20:]
        anomaly_score = np.mean(np.abs(np.diff(recent, axis=0)), axis=0)
        fig_anom = go.Figure(data=[go.Bar(x=sensor_names[:10], y=anomaly_score[:10], marker_color='orange')])
        fig_anom.update_layout(title="Anomaly Score (Recent Change Magnitude)", template="plotly_dark", height=400)
    else:
        fig_anom = go.Figure()
    
    status_text = f"Live | History: {len(data_queue)} | Predictions: {len(prediction_queue)}"
    return fig_sensors, fig_3d, fig_pred, fig_anom, status_text

