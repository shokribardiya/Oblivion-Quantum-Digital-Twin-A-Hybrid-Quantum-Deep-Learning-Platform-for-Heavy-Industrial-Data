# =============================================================================
# بلوک ۸: آموزش اولیه مدل (قبل از راه‌اندازی داشبورد)
# =============================================================================
def pretrain_model():
    global twin_engine
    logger.info("Starting initial model pretraining...")
    # ایجاد داده آموزشی
    train_stream = HeavyDataStream(n_sensors=n_sensors_display, sample_rate=50, base_seed=0)
    dataset = TimeSeriesWindowDataset(train_stream.stream(), seq_len=30, horizon=10, max_samples=2000)
    loader = DataLoader(dataset, batch_size=32, shuffle=True)
    model = DeepQuantumTwin(input_dim=n_sensors_display, seq_len=30, hidden_dim=64, horizon=10).to(DEVICE)
    criterion = nn.MSELoss()
    optimizer = optim.Adam(model.parameters(), lr=0.001)
    model.train()
    for epoch in range(20):
        total_loss = 0
        for X, y in loader:
            X, y = X.to(DEVICE), y.to(DEVICE)
            # y باید به شکل (batch, horizon, n_sensors) باشد
            y = y.unsqueeze(1).repeat(1, 10, 1)  # تکرار هدف ساده (در عمل باید پنجره‌های آینده واقعی داد)
            optimizer.zero_grad()
            pred = model(X)
            loss = criterion(pred, y)
            loss.backward()
            optimizer.step()
            total_loss += loss.item()
        logger.info(f"Epoch {epoch+1}/20, Loss: {total_loss/len(loader):.6f}")
    model.eval()
    twin_engine = DigitalTwinEngine(model, seq_len=30, n_sensors=n_sensors_display)
    # پر کردن تاریخچه اولیه
    for _ in range(30):
        sample = streamer.generate_sample()
        twin_engine.update_state(sample)
        data_queue.append(sample)
    logger.info("Pretraining complete. Twin engine ready.")

# اجرای اولیه پیش‌آموزش
pretrain_model()

