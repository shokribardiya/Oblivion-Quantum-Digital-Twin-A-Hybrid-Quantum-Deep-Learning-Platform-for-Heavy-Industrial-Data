# بلوک ۲: شبیه‌ساز جریان داده‌های سنگین (Industrial IoT)
# =============================================================================
class HeavyDataStream:
    """
    شبیه‌ساز جریان داده‌های سنگین از منابع مختلف (سنسورهای توربین، دما، فشار، لرزش و ...)
    قابلیت اتصال به Kafka، Redpanda، یا فایل‌های CSV حجیم.
    در این نسخه داده‌های مصنوعی با الگوی دینامیک پیچیده تولید می‌شود.
    """
    def __init__(self, n_sensors: int = 20, sample_rate: float = 100.0, base_seed: int = 42):
        self.n_sensors = n_sensors
        self.sample_rate = sample_rate
        self.base_seed = base_seed
        self.rng = np.random.default_rng(base_seed)
        self.time_step = 0
        # پارامترهای پنهان برای دینامیک غیرخطی
        self.freqs = self.rng.uniform(0.1, 2.0, size=n_sensors)
        self.phases = self.rng.uniform(0, 2*np.pi, size=n_sensors)
        self.amplitudes = self.rng.uniform(0.5, 2.0, size=n_sensors)
        # روند آهسته و نویز
        self.trend = np.zeros(n_sensors)

    def generate_sample(self) -> np.ndarray:
        """تولید یک بردار اندازه‌گیری در گام زمانی فعلی و پیشروی زمان"""
        t = self.time_step / self.sample_rate
        # سیگنال پایه: ترکیب امواج سینوسی با نویز غیرگوسی
        base = self.amplitudes * np.sin(2*np.pi*self.freqs*t + self.phases)
        # افزودن وابستگی بین سنسوری (covariance matrix simulation)
        cross_talk = 0.1 * np.roll(base, 2)
        # افزودن روند و اغتشاش
        self.trend += self.rng.normal(0, 0.01, size=self.n_sensors)
        noise = self.rng.standard_t(self.n_sensors) * 0.2  # توزیع t برای سنگینی دنباله
        sample = base + cross_talk + self.trend + noise
        self.time_step += 1
        return sample

    def stream(self, batch_size: int = 1024) -> Generator[np.ndarray, None, None]:
        """ژنراتور بی‌پایان برای شبیه‌سازی جریان داده"""
        while True:
            batch = np.array([self.generate_sample() for _ in range(batch_size)])
            yield batch

    def reset(self):
        self.time_step = 0
        self.rng = np.random.default_rng(self.base_seed)
        self.trend = np.zeros(self.n_sensors)

