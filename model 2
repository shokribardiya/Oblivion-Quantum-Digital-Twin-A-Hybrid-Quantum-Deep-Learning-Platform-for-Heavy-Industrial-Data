# بلوک ۴: الگوریتم‌های کوانتومی آماده
# =============================================================================
def quantum_feature_circuit(inputs, weights):
    """
    مدار کوانتومی پارامتری (VQC) برای استخراج ویژگی‌های کوانتومی.
    این مدار یک بردار ورودی کلاسیک (کاهش‌یافته) را کدگذاری کرده و با لایه‌های چرخشی
    و درهم‌تنیدگی، یک بردار خروجی تولید می‌کند که امیدریاضی عملگرهای پائولی Z هر کیوبیت است.
    """
    # کدگذاری دامنه: استفاده از چرخش‌های RX, RY, RZ بر اساس ورودی
    for i in range(NUM_QUBITS):
        qml.RX(inputs[i % len(inputs)], wires=i)
        qml.RY(inputs[(i+1) % len(inputs)], wires=i)
    # لایه‌های پارامتری
    n_layers = weights.shape[0]
    for layer in range(n_layers):
        # چرخش‌های پارامتری
        for i in range(NUM_QUBITS):
            qml.Rot(weights[layer, i, 0], weights[layer, i, 1], weights[layer, i, 2], wires=i)
        # درهم‌تنیدگی حلقه‌ای
        for i in range(NUM_QUBITS-1):
            qml.CNOT(wires=[i, i+1])
        qml.CNOT(wires=[NUM_QUBITS-1, 0])  # حلقه بسته
    # اندازه‌گیری: مقدار انتظاری Z برای هر کیوبیت
    return [qml.expval(qml.PauliZ(i)) for i in range(NUM_QUBITS)]

# ایجاد QNode
qnode = qml.QNode(quantum_feature_circuit, dev_quantum, interface="torch", diff_method="best")

class QuantumLayer(nn.Module):
    """
    لایهٔ کوانتومی قابل آموزش در PyTorch که یک ورودی را به فضای ویژگی کوانتومی می‌برد.
    """
    def __init__(self, input_dim, n_layers=2, n_qubits=NUM_QUBITS):
        super().__init__()
        self.input_dim = input_dim
        self.n_qubits = n_qubits
        self.n_layers = n_layers
        # وزن‌های مدار کوانتومی
        weight_shapes = {"weights": (n_layers, n_qubits, 3)}
        self.qlayer = qml.qnn.TorchLayer(qnode, weight_shapes)

    def forward(self, x):
        # x: (batch, input_dim) -> باید به اندازه n_qubits برسانیم؛ با یک لایه خطی کاهش ابعاد
        if self.input_dim != self.n_qubits:
            reduction = nn.Linear(self.input_dim, self.n_qubits, bias=False).to(x.device)
            x = reduction(x)
        return self.qlayer(x)

# =============================================================================
# بلوک ۵: مدل‌های یادگیری آماده – معماری هیبرید کوانتومی-عمیق
# =============================================================================
class ConvLSTMCell(nn.Module):
    """یک سلول ConvLSTM ساده برای سری‌های زمانی چندمتغیره (بدون بعد فضایی، حالت برداری)"""
    def __init__(self, input_dim, hidden_dim, kernel_size=3, bias=True):
        super().__init__()
        self.input_dim = input_dim
        self.hidden_dim = hidden_dim
        padding = kernel_size // 2
        # گیت‌ها: ورودی، فراموشی، خروجی، وضعیت سلول
        self.conv = nn.Conv1d(in_channels=input_dim+hidden_dim,
                              out_channels=4*hidden_dim,
                              kernel_size=kernel_size,
                              padding=padding,
                              bias=bias)

    def forward(self, x, cur_state):
        h_cur, c_cur = cur_state
        # x: (batch, seq_len, features) -> باید برای Conv1d به شکل (batch, features, seq_len) تبدیل کنیم
        x_t = x.transpose(1, 2)  # (batch, features, seq_len)؟
        # ساده‌سازی: عملیات بر روی تک‌گامی انجام می‌شود، پس seq_len=1
        combined = torch.cat([x_t, h_cur], dim=1)  # (batch, input_dim+hidden_dim, 1)
        gates = self.conv(combined)  # (batch, 4*hidden_dim, 1)
        # جدا کردن گیت‌ها
        i, f, o, g = torch.split(gates, self.hidden_dim, dim=1)
        i = torch.sigmoid(i)
        f = torch.sigmoid(f)
        o = torch.sigmoid(o)
        g = torch.tanh(g)
        c_next = f * c_cur + i * g
        h_next = o * torch.tanh(c_next)
        return h_next, c_next

class DeepQuantumTwin(nn.Module):
    """
    مدل اصلی دیجیتال توأمان: شبکه‌ای متشکل از ConvLSTM + لایهٔ کوانتومی + فیدفوروارد.
    """
    def __init__(self, input_dim, seq_len, hidden_dim=64, n_quantum_features=4, horizon=10):
        super().__init__()
        self.seq_len = seq_len
        self.input_dim = input_dim
        self.hidden_dim = hidden_dim
        self.horizon = horizon

        # ConvLSTM برای کدگذاری توالی
        self.lstm_cell = ConvLSTMCell(input_dim, hidden_dim, kernel_size=3)
        # لایه کاهش ابعاد برای تغذیه به بخش کوانتومی
        self.to_quantum_input = nn.Linear(hidden_dim, 8)  # 8 ویژگی قبل از کاهش در QuantumLayer
        self.quantum = QuantumLayer(input_dim=8, n_layers=2, n_qubits=NUM_QUBITS)
        # بخش کلاسیک
        self.classical_encoder = nn.Sequential(
            nn.Linear(hidden_dim, 128),
            nn.ReLU(),
            nn.Dropout(0.2),
        )
        # ترکیب ویژگی‌های کلاسیک و کوانتومی
        fusion_dim = 128 + NUM_QUBITS
        self.fusion = nn.Sequential(
            nn.Linear(fusion_dim, 128),
            nn.ReLU(),
            nn.Linear(128, input_dim * horizon),  # پیش‌بینی چندگامی
        )

    def forward(self, x):
        # x: (batch, seq_len, input_dim)
        batch_size = x.shape[0]
        h = torch.zeros(batch_size, self.hidden_dim, 1, device=x.device)
        c = torch.zeros(batch_size, self.hidden_dim, 1, device=x.device)
        # عبور توالی از ConvLSTM
        for t in range(self.seq_len):
            x_t = x[:, t, :]  # (batch, input_dim)
            x_t = x_t.unsqueeze(-1)  # (batch, input_dim, 1)
            h, c = self.lstm_cell(x_t, (h, c))
        # h اکنون (batch, hidden_dim, 1)
        h_last = h.squeeze(-1)  # (batch, hidden_dim)
        # مسیر کلاسیک
        classical_feat = self.classical_encoder(h_last)
        # مسیر کوانتومی
        q_input = self.to_quantum_input(h_last)  # (batch, 8)
        quantum_feat = self.quantum(q_input)  # (batch, NUM_QUBITS)
        # تلفیق
        combined = torch.cat([classical_feat, quantum_feat], dim=1)
        out = self.fusion(combined)  # (batch, input_dim * horizon)
        out = out.view(batch_size, self.horizon, self.input_dim)
        return out

