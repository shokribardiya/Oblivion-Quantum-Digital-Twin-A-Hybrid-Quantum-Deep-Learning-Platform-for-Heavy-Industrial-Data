# بلوک ۳: پیش‌پردازش و ساخت پنجره‌های زمانی (Windowing)
# =============================================================================
class TimeSeriesWindowDataset(Dataset):
    """
    مجموعه‌داده‌ای که از یک جریان پنجره‌های (seq_len) ورودی و هدف بعدی می‌سازد.
    """
    def __init__(self, stream_generator, seq_len: int = 50, horizon: int = 10, max_samples: int = 10000):
        self.seq_len = seq_len
        self.horizon = horizon
        self.max_samples = max_samples
        self.X, self.y = self._build_dataset(stream_generator)

    def _build_dataset(self, gen):
        X_list, y_list = [], []
        buffer = deque(maxlen=self.seq_len)
        for batch in gen:
            for sample in batch:
                if len(buffer) == self.seq_len:
                    X_list.append(np.array(buffer))
                    # هدف: میانگین وضعیت در افق پیش‌بینی (می‌توان پنجره‌های بعدی را هم گرفت)
                    y_list.append(sample)  # در اینجا گام بعدی
                    if len(X_list) >= self.max_samples:
                        return np.array(X_list), np.array(y_list)
                buffer.append(sample)
        return np.array(X_list), np.array(y_list)

    def __len__(self):
        return len(self.X)

    def __getitem__(self, idx):
        return torch.tensor(self.X[idx], dtype=torch.float32), torch.tensor(self.y[idx], dtype=torch.float32)

