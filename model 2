# بلوک ۶: هستهٔ دیجیتال توأمان و حلقهٔ به‌روزرسانی
# =============================================================================
class DigitalTwinEngine:
    """
    موتور اصلی همزاد دیجیتال که با مدل آموزش‌دیده، وضعیت فعلی را دریافت و
    پیش‌بینی‌های آینده را ارائه می‌کند. همچنین قابلیت یادگیری برخط دارد.
    """
    def __init__(self, model: nn.Module, seq_len: int, n_sensors: int):
        self.model = model.to(DEVICE)
        self.model.eval()  # در آغاز حالت ارزیابی
        self.seq_len = seq_len
        self.n_sensors = n_sensors
        self.history_buffer = deque(maxlen=seq_len)
        self.optimizer = None  # برای یادگیری برخط
        self.criterion = nn.MSELoss()

    def update_state(self, new_measurement: np.ndarray):
        """افزودن یک اندازه‌گیری جدید به تاریخچه"""
        self.history_buffer.append(new_measurement)

    def predict_next(self) -> np.ndarray:
        """پیش‌بینی وضعیت در افق پیش‌بینی بر اساس تاریخچه موجود"""
        if len(self.history_buffer) < self.seq_len:
            raise ValueError("Not enough history for prediction")
        input_seq = np.array(list(self.history_buffer))[-self.seq_len:]  # (seq_len, n_sensors)
        input_tensor = torch.tensor(input_seq, dtype=torch.float32).unsqueeze(0).to(DEVICE)  # (1, seq_len, n_sensors)
        with torch.no_grad():
            pred = self.model(input_tensor)  # (1, horizon, n_sensors)
        return pred.squeeze(0).cpu().numpy()  # (horizon, n_sensors)

    def continuous_learning_step(self, new_data_tuple: Tuple[np.ndarray, np.ndarray]):
        """یک گام یادگیری برخط با داده جدید (X, y)."""
        if self.optimizer is None:
            self.optimizer = optim.Adam(self.model.parameters(), lr=1e-4)
        self.model.train()
        X, y = new_data_tuple
        X_t = torch.tensor(X, dtype=torch.float32).unsqueeze(0).to(DEVICE)
        y_t = torch.tensor(y, dtype=torch.float32).unsqueeze(0).to(DEVICE)
        self.optimizer.zero_grad()
        pred = self.model(X_t)
        loss = self.criterion(pred, y_t)
        loss.backward()
        self.optimizer.step()
        self.model.eval()
        return loss.item()

